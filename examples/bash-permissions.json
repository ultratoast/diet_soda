{
  "blocked_commands": [
    "shred", "mkfs", "fdisk", "diskutil", "dd",
    "shutdown", "poweroff", "reboot", "halt", "kill", "pkill", "killall",
    "mount", "umount", "iptables", "pfctl",
    "gcloud", "az", "terraform", "kubectl", "helm"
  ],
  "blocked_patterns": [
    "rm -rf", "rm -fr",
    "docker system prune", "docker volume rm", "docker rm -f",
    "curl | sh", "curl | bash", "wget | sh", "wget | bash",
    "> /dev/", "2>/dev/", ":(){ :|:& };:", "base64 -d | sh",
    "terraform destroy", "kubectl delete",
    "kubectl apply", "kubectl replace", "helm uninstall"
  ],
  "bash": {
    "*": "allow",
    "find -delete*": "ask",
    "find * -delete*": "ask",
    "find -exec*": "ask",
    "find * -exec*": "ask",
    "find -ok*": "ask",
    "find * -ok*": "ask",
    "find -fprint*": "ask",
    "find * -fprint*": "ask",
    "find -fls*": "ask",
    "find * -fls*": "ask",
    "git push*": "ask",
    "git reset *--hard*": "ask",
    "git reset *--merge*": "ask",
    "git clean*": "ask",
    "git restore*": "ask",
    "git rebase*": "ask",
    "git checkout -f*": "ask",
    "git checkout * -f*": "ask",
    "git checkout *--force*": "ask",
    "git checkout -- *": "ask",
    "git checkout * -- *": "ask",
    "git checkout .": "ask",
    "git switch -f*": "ask",
    "git switch * -f*": "ask",
    "git switch *--force*": "ask",
    "git switch *--discard-changes*": "ask",
    "git branch -D*": "ask",
    "git branch -d*": "ask",
    "git branch *--delete*": "ask",
    "git stash drop*": "ask",
    "git stash clear*": "ask",
    "git tag -d*": "ask",
    "git filter-branch*": "ask",
    "git reflog expire*": "ask",
    "git reflog delete*": "ask",
    "git update-ref*": "ask",
    "git worktree remove*": "ask",
    "svn*": "ask",
    "hg*": "ask",
    "hub*": "ask",
    "npm install*": "ask",
    "npm uninstall*": "ask",
    "npm publish*": "ask",
    "pnpm install*": "ask",
    "pnpm publish*": "ask",
    "yarn add*": "ask",
    "yarn publish*": "ask",
    "pip install*": "ask",
    "pip3 install*": "ask",
    "pip uninstall*": "ask",
    "cargo publish*": "ask",
    "cargo login*": "ask",
    "cargo yank*": "ask",
    "cargo owner*": "ask",
    "cargo install*": "ask",
    "rmdir*": "ask",
    "chmod*": "ask",
    "chown*": "ask",
    "systemctl*": "ask",
    "launchctl*": "ask",
    "service*": "ask",
    "crontab*": "ask",
    "at*": "ask",
    "atrm*": "ask",
    "brew*": "ask",
    "apt*": "ask",
    "apt-get*": "ask",
    "dpkg*": "ask",
    "yum*": "ask",
    "dnf*": "ask",
    "pacman*": "ask",
    "zypper*": "ask",
    "snap*": "ask",
    "flatpak*": "ask",
    "emerge*": "ask",
    "portage*": "ask",
    "docker *": "ask",
    "podman *": "ask",
    "aws *": "ask",
    "gws *": "ask",
    "sudo*": "ask",
    "su": "ask",
    "su *": "ask",
    "doas*": "ask",
    "curl*": "ask",
    "wget*": "ask",
    "http*": "ask",
