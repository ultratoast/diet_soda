{
  "blocked_commands": [
    "rm", "rmdir", "shred", "mkfs", "fdisk", "diskutil", "dd",
    "shutdown", "poweroff", "reboot", "halt", "kill", "pkill", "killall",
    "chmod", "chown", "mount", "umount", "iptables", "pfctl",
    "gcloud", "az", "terraform", "kubectl", "helm"
  ],
  "blocked_patterns": [
    "rm -rf", "rm -fr",
    "docker system prune", "docker volume rm", "docker rm -f",
    "curl | sh", "curl | bash", "wget | sh", "wget | bash",
    "> /dev/", "2>/dev/", ":(){ :|:& };:", "base64 -d | sh",
    "terraform destroy", "kubectl delete",
    "kubectl apply", "kubectl replace", "helm uninstall"
  ],
  "bash": {
    "*": "ask",
    "git rev-parse*": "allow",
    "git ls-files*": "allow",
    "git status*": "allow",
    "git diff*": "allow",
    "git log*": "allow",
    "git show*": "allow",
    "git blame*": "allow",
    "git rev-list*": "allow",
    "git describe*": "allow",
    "git shortlog*": "allow",
    "git ls-tree*": "allow",
    "git cat-file*": "allow",
    "git show-ref*": "allow",
    "git merge-base*": "allow",
    "git name-rev*": "allow",
    "git branch --list*": "allow",
    "git branch -a": "allow",
    "git branch -r": "allow",
    "git branch -v*": "allow",
    "git branch --show-current": "allow",
    "git tag --list*": "allow",
    "git tag -l*": "allow",
    "git remote -v": "allow",
    "git stash list*": "allow",
    "ls*": "allow",
    "cat*": "allow",
    "head*": "allow",
    "tail*": "allow",
    "grep*": "allow",
    "wc*": "allow",
    "pwd*": "allow",
    "which*": "allow",
    "gh pr list*": "allow",
    "gh pr view*": "allow",
    "gh pr checks*": "allow",
    "gh pr status*": "allow",
    "gh issue list*": "allow",
    "gh issue view*": "allow",
    "gh run list*": "allow",
    "gh run view*": "allow",
    "gh repo view*": "allow",
    "git push*": "ask",
    "npm install*": "ask",
    "npm uninstall*": "ask",
    "git * --output*": "deny",
    "git * --ext-diff*": "deny",
    "git * --textconv*": "deny",
    "git * --filters*": "deny",
    "git * --open-files-in-pager*": "deny",
    "git push --force*": "deny"
  }
}
