    "traceroute*": "ask",
    "mtr*": "ask",
    "dig*": "ask",
    "nslookup*": "ask",
    "host*": "ask",
    "ip*": "ask",
    "ifconfig*": "ask",
    "ufw*": "ask",
    "firewall-cmd*": "ask",
    "tcpdump*": "ask",
    "nmap*": "ask",
    "git * --output*": "deny",
    "git * --ext-diff*": "deny",
    "git * --textconv*": "deny",
    "git * --filters*": "deny",
    "git * --open-files-in-pager*": "deny",
